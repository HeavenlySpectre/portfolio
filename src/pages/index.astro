---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
const ids = ['drives', 'projects', 'experience', 'achievements', 'organizations', 'toolkit', 'education', 'contact'];
---
<Base
  title="Kevin Anugerah Faza"
  description="I build AI and data systems that work beyond the notebook."
  canonical="https://kevinanugerah.dev/"
  ogImage="https://kevinanugerah.dev/og-image.png"
  jsonLd={[]}
>
  <Loader />
  <main>
    <Hero />
    {ids.map((id) => (id === 'projects' ? <Projects /> : <section id={id}><h2>{id}</h2></section>))}
  </main>
</Base>
