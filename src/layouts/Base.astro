---
import '../styles/base.css';
import '../styles/shell.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage: string;
  jsonLd: object[];
  /** false on pages other than the home page: the nav then links back to the home sections */
  home?: boolean;
}
const { title, description, canonical, ogImage, jsonLd, home = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={plex400} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <Nav home={home} />
    <slot />
    <Footer />
    <script>
      import '../scripts/nav';
    </script>
  </body>
</html>
