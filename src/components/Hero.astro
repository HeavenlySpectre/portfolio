---
---
<section class="hero" id="top" aria-label="Introduction">
  <canvas id="bgc" aria-hidden="true"></canvas>
  <div class="dim" aria-hidden="true"></div>
  <div class="stack">
    <p class="prompt"><b>kevin@portfolio</b>:~$ whoami</p>
    <h1 class="rv" aria-label="Kevin Anugerah Faza"><span aria-hidden="true">Kevin</span> <span aria-hidden="true">Anugerah</span> <span aria-hidden="true">Faza</span></h1>
    <p class="role rv">AI &amp; Data Engineer<span class="cursor" aria-hidden="true"></span></p>
    <p class="intro rv">I build AI and data systems that work beyond the notebook.</p>
  </div>
  <div id="slot" aria-hidden="true"></div>
  <div class="bar rv">
    <p class="cap" id="cap">linked · one system: every generated token adds a row and column to the attention matrix of the sentence so far</p>
  </div>
  <p class="hint rv" aria-hidden="true">move the cursor</p>
</section>

<style is:global>
  .hero { position: relative; min-height: max(100vh, 46rem); min-height: max(100svh, 46rem); margin-top: -3rem; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; justify-content: center; padding: 5.5rem var(--padx) 6.5rem; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 4; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0,0,0,.2) 0 1px, transparent 1px 3px); }
  #bgc { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; display: block; }
  .dim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(ellipse 62% 58% at 26% 50%, rgb(var(--bg-rgb) / .8), rgb(var(--bg-rgb) / .42) 62%, rgb(var(--bg-rgb) / 0) 100%), linear-gradient(0deg, rgb(var(--bg-rgb) / .7), rgb(var(--bg-rgb) / 0) 22%), linear-gradient(180deg, rgb(var(--bg-rgb) / .6), rgb(var(--bg-rgb) / 0) 18%); }
  .stack { position: relative; z-index: 3; max-width: min(48rem, calc(100% - min(42vw, 34rem) - 2rem)); pointer-events: none; }
  .prompt { margin: 0 0 1rem; font-size: var(--pf); line-height: 1.6; color: var(--muted); }
  .prompt b { color: var(--accent); font-weight: 500; }
  .hero h1 { margin: 0; font-weight: 700; font-size: clamp(2.1rem, 6.4vw, 6rem); line-height: 1; letter-spacing: -.05em; text-transform: uppercase; color: var(--accent); text-shadow: 0 0 var(--glow-blur) var(--accent-glow); font-variant-ligatures: none; contain: layout style; }
  .hero h1 span { display: inline-block; margin-right: .3em; }
  .role { margin: 1.2rem 0 0; font-size: clamp(.95rem, 1.6vw, 1.3rem); color: var(--text); }
  .role::before { content: "> "; color: var(--accent); }
  .intro { max-width: 46ch; margin: 1rem 0 0; font-size: clamp(.88rem, 1.15vw, 1rem); line-height: 1.6; color: color-mix(in srgb, var(--text) 80%, transparent); }
  .cursor { display: inline-block; width: .6em; height: 1.05em; margin-left: .3em; background: var(--accent); vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
  .rv { transition: opacity .5s ease; }
  html.ld .rv { opacity: 0; transition: none; }
  #slot { position: absolute; z-index: 2; right: var(--padx); top: 5.5rem; bottom: 5.5rem; width: min(42vw, 34rem); pointer-events: none; }
  .bar { position: absolute; z-index: 6; left: var(--padx); bottom: 3.8rem; right: var(--padx); display: flex; flex-direction: column; gap: .5rem; align-items: flex-start; }
  .cap { margin: 0; font: 400 .72rem/1.4 var(--mono); color: var(--text); background: rgb(var(--bg-rgb) / .7); padding: .2rem .1rem; max-width: 100%; }
  .cap::before { content: "# "; color: var(--accent); }
  .hint { position: absolute; z-index: 5; bottom: 1rem; right: var(--padx); margin: 0; font-size: .72rem; color: var(--muted); pointer-events: none; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 760px) {
    .hero { min-height: 100svh; justify-content: flex-start; padding: 4.6rem var(--padx) 1.4rem; }
    .stack { max-width: none; }
    .hero h1 { font-size: clamp(2.1rem, 13vw, 3.6rem); }
    #slot { position: relative; right: auto; top: auto; bottom: auto; width: 100%; height: 520px; margin-top: 1.4rem; }
    .bar { position: relative; left: auto; right: auto; bottom: auto; margin-top: .9rem; }
    .hint { display: none; }
    .dim { bottom: auto; background: linear-gradient(180deg, rgb(var(--bg-rgb) / .9) 0, rgb(var(--bg-rgb) / .84) 80%, rgb(var(--bg-rgb) / 0) 100%); }
  }
</style>

<script>
  import '../scripts/hero';
</script>
